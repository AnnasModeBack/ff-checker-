<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnnasAI3D" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryDark">@color/dark_bg</item>
        <item name="colorAccent">@color/neon_emerald</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
    </style>

    <style name="UltraDisplayTitle">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="UltraSectionLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="UltraReadableBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
