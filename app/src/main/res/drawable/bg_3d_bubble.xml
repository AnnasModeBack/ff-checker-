<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:centerColor="#0284C7"
                android:endColor="#7C3AED"
                android:startColor="#00F0FF" />
            <size android:width="76dp" android:height="76dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#070C1C"
                android:startColor="#1B2A4E" />
            <stroke android:width="2dp" android:color="#CC00F0FF" />
        </shape>
    </item>
</layer-list>
