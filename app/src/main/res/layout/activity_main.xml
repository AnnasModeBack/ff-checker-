<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/mainCardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_kece_card"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivHero3D"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Logo 3D Full HD"
                android:src="@drawable/ic_app_logo_3d" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UltraDisplayTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANNAS AI 3D ULTRA"
                    android:textColor="@color/neon_cyan"
                    android:textSize="22sp" />

                <TextView
                    style="@style/UltraReadableBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Java Native • 3D Motion • SVG HD • v12"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvServiceStatus"
                    style="@style/UltraSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="STATUS: SIAP DIAKTIFKAN"
                    android:textColor="@color/neon_emerald"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_kece_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/UltraSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE GEMINI API KEY"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etApiKey"
                style="@style/UltraReadableBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/dark_card"
                android:hint="Masukkan API Key (AIzaSy...)"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/UltraSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="MODE PENGERJAAN TUGAS"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@color/dark_card"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    style="@style/UltraDisplayTitle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_neon_button"
                    android:drawableStart="@drawable/ic_svg_check"
                    android:paddingHorizontal="12dp"
                    android:text="SIMPAN"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTestApi"
                    style="@style/UltraSectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:drawableStart="@drawable/ic_svg_sparkle"
                    android:paddingHorizontal="10dp"
                    android:text="TES API"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnRequestNotif"
            style="@style/UltraSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#141E38"
            android:drawableStart="@drawable/ic_svg_bell"
            android:paddingHorizontal="16dp"
            android:text="IZINKAN PEMBERITAHUAN"
            android:textColor="@color/neon_amber"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStartOverlay"
            style="@style/UltraDisplayTitle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_check_emerald"
            android:drawableStart="@drawable/ic_svg_sparkle"
            android:paddingHorizontal="16dp"
            android:text="AKTIFKAN FLOATING AI 3D"
            android:textColor="#050814"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnStopOverlay"
            style="@style/UltraSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#DC2626"
            android:drawableStart="@drawable/ic_svg_close"
            android:paddingHorizontal="16dp"
            android:text="MATIKAN FLOATING AI"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
