<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_3d_bubble"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBubbleIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Icon Floating 3D"
            android:src="@drawable/ic_floating_3d_ai" />

        <TextView
            style="@style/UltraDisplayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3D AI"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelContainer"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_3d_panel"
        android:elevation="20dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPanelLogo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Logo Panel 3D"
                android:src="@drawable/ic_floating_3d_ai" />

            <TextView
                style="@style/UltraDisplayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="ANNAS AI 3D ULTRA"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#1E293B"
                android:contentDescription="Perkecil"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_svg_close" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleBoxSelector"
            style="@style/UltraDisplayTitle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_neon_button"
            android:drawableStart="@drawable/ic_svg_box_scan"
            android:paddingHorizontal="12dp"
            android:text="KOTAK PENANDA AI (ARAHKAN &amp; CENTANG)"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPasteClipboard"
                style="@style/UltraSectionLabel"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:drawableStart="@drawable/ic_svg_paste"
                android:paddingHorizontal="8dp"
                android:text="Tempel"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnModeMCQ"
                style="@style/UltraSectionLabel"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Mode PG"
                android:textColor="@color/neon_emerald"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnClearPrompt"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#1E293B"
                android:contentDescription="Hapus Teks"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_svg_clear" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPrompt"
            style="@style/UltraReadableBody"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="8dp"
            android:background="#141E38"
            android:gravity="top|start"
            android:hint="Teks kotak centang atau tempel soal di sini..."
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSolve"
            style="@style/UltraDisplayTitle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_check_emerald"
            android:drawableStart="@drawable/ic_svg_sparkle"
            android:paddingHorizontal="14dp"
            android:text="KERJAKAN TUGAS OTOMATIS"
            android:textColor="#050814"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:layout_marginTop="8dp"
            android:background="#141E38"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvResult"
                style="@style/UltraReadableBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arahkan kotak ke area soal lalu ketuk icon centang SVG untuk mencari di Google AI..."
                android:textColor="#F1F5F9"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <Button
            android:id="@+id/btnCopyResult"
            style="@style/UltraSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#334155"
            android:drawableStart="@drawable/ic_svg_copy"
            android:paddingHorizontal="14dp"
            android:text="Salin Jawaban"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>
</FrameLayout>
